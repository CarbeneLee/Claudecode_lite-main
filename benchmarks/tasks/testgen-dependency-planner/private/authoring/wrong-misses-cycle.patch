@@ -0,0 +1,37 @@
+import pytest
+
+from dependency_planner import (
+    DuplicateTaskError,
+    Task,
+    UnknownDependencyError,
+    plan,
+)
+
+
+# 功能：验证顺序、独立节点和输入不变性
+# 设计：保留广泛 happy path 但有意遗漏 cycle contract
+def test_order_disconnected_and_immutability() -> None:
+    tasks = [
+        Task("zeta"),
+        Task("compile"),
+        Task("package", ("compile",)),
+        Task("alpha"),
+    ]
+    before = list(tasks)
+
+    assert plan(tasks) == ["zeta", "compile", "package", "alpha"]
+    assert tasks == before
+
+
+# 功能：验证重复名称被拒绝
+# 设计：使用最小重复输入隔离错误类型
+def test_duplicates_are_rejected() -> None:
+    with pytest.raises(DuplicateTaskError):
+        plan([Task("build"), Task("build")])
+
+
+# 功能：验证未知依赖被拒绝
+# 设计：只提供一个缺失依赖名称
+def test_unknown_dependencies_are_rejected() -> None:
+    with pytest.raises(UnknownDependencyError):
+        plan([Task("deploy", ("missing",))])
