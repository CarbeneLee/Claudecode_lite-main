+
+
+def low_stock_names(
+    products: Iterable[Product],
+    threshold: int,
+) -> list[str]:
+    if threshold < 0:
+        raise ValueError("negative threshold")
+    return sorted(
+        product.name for product in products if product.quantity <= threshold
+    )
