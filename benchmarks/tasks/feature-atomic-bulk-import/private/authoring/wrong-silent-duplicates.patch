 from orders.parser import parse_order_row
 from orders.store import InMemoryOrderStore
 
@@ -12,2 +12,19 @@ def create_order(
     store.add(order)
     return order
+
+
+def import_orders(
+    store: InMemoryOrderStore,
+    rows: Iterable[Mapping[str, str]],
+) -> ImportSummary:
+    parsed = {
+        order.order_id: order
+        for order in (parse_order_row(row) for row in rows)
+    }
+    combined = {order.order_id: order for order in store.all_orders()}
+    combined.update(parsed)
+    store.replace_all(combined.values())
+    return ImportSummary(
+        imported_count=len(parsed),
+        order_ids=tuple(parsed),
+    )
