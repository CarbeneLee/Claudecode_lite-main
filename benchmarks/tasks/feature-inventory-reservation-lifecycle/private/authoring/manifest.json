  "requirement_test_matrix": [
    {
      "requirement_id": "atomic-reservation",
      "public_contract": "reserve creates a pending record and reduces stock atomically; invalid or insufficient requests leave no partial state",
      "criterion_ids": ["target-tests"],
      "hidden_evidence": [
        "hidden_tests/test_target.py::test_reserve_reduces_available_and_creates_pending_record",
        "hidden_tests/test_target.py::test_failed_reserve_has_no_partial_mutation"
      ],
      "out_of_scope": "database transactions or concurrent requests"
    },
    {
      "requirement_id": "request-idempotency",
      "public_contract": "same key and arguments reuse one reservation while changed arguments conflict without mutation",
      "criterion_ids": ["target-tests"],
      "hidden_evidence": [
        "hidden_tests/test_target.py::test_request_key_idempotency_and_conflict"
      ],
      "out_of_scope": "request-key expiry"
    },
    {
      "requirement_id": "terminal-lifecycle",
      "public_contract": "confirm and release are same-state idempotent, release restores once, and confirmed cannot release",
      "criterion_ids": ["target-tests"],
      "hidden_evidence": [
        "hidden_tests/test_target.py::test_confirm_is_idempotent_without_stock_change",
        "hidden_tests/test_target.py::test_release_is_idempotent_and_restores_exactly_once",
        "hidden_tests/test_target.py::test_confirmed_reservation_cannot_be_released"
      ],
      "out_of_scope": "reservation expiry or cancellation after confirmation"
    },
    {
      "requirement_id": "cross-entity-isolation",
      "public_contract": "reservations for different requests and SKUs do not share state",
      "criterion_ids": ["target-tests"],
      "hidden_evidence": [
        "hidden_tests/test_target.py::test_reservations_keep_skus_and_requests_independent"
      ],
      "out_of_scope": "multi-warehouse allocation"
    },
    {
      "requirement_id": "existing-inventory-contract",
      "public_contract": "inventory query, positive adjustment, unknown SKU, and negative-stock protection remain stable",
      "criterion_ids": ["regression-tests"],
      "hidden_evidence": [
        "hidden_tests/test_regression.py::test_existing_query_and_adjustment_contract",
        "hidden_tests/test_regression.py::test_existing_error_contract"
      ],
      "out_of_scope": "redesigning InventoryStore or InventoryService"
    }
  ],
