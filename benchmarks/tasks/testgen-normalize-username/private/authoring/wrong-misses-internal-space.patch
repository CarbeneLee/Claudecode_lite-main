--- a/tests/test_text_utils.py
+++ b/tests/test_text_utils.py
@@ -1,5 +1,21 @@
+import pytest
+
 from text_utils import normalize_username
 
 
 def test_normalize_username_trims_and_lowercases() -> None:
     assert normalize_username(" Alice ") == "alice"
+
+
+def test_normalize_username_rejects_empty() -> None:
+    with pytest.raises(ValueError):
+        normalize_username("")
+
+
+def test_normalize_username_rejects_blank() -> None:
+    with pytest.raises(ValueError):
+        normalize_username("   ")
+
+
+def test_normalize_username_converts_underscore() -> None:
+    assert normalize_username("First_Last") == "first-last"
